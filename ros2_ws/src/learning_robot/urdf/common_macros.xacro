<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ============ 通用材质 ============ -->
    <xacro:macro name="declare_material" params="name rgba">
        <material name="${name}">
            <color rgba="${rgba}" />
        </material>
    </xacro:macro>

    <!-- ============ 长方体 link ============ -->
    <xacro:macro name="box_link" params="name length width height mass color origin:='0 0 0'">
        <link name="${name}">
            <visual>
                <geometry>
                    <box size="${length} ${width} ${height}" />
                </geometry>
                <origin xyz="${origin}" rpy="0 0 0" />
                <material name="${color}" />
            </visual>
            <collision>
                <geometry>
                    <box size="${length} ${width} ${height}" />
                </geometry>
                <origin xyz="${origin}" rpy="0 0 0" />
            </collision>
            <inertial>
                <origin xyz="${origin}" rpy="0 0 0" />
                <mass value="${mass}" />
                <inertia
                    ixx="${mass * (width*width + height*height) / 12}"
                    ixy="0.0" ixz="0.0"
                    iyy="${mass * (length*length + height*height) / 12}"
                    iyz="0.0"
                    izz="${mass * (length*length + width*width) / 12}" />
            </inertial>
        </link>
    </xacro:macro>

    <!-- ============ 圆柱 link ============ -->
    <xacro:macro name="cylinder_link" params="name radius length mass color origin:='0 0 0'">
        <link name="${name}">
            <visual>
                <geometry>
                    <cylinder radius="${radius}" length="${length}" />
                </geometry>
                <origin xyz="${origin}" rpy="0 0 0" />
                <material name="${color}" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${radius}" length="${length}" />
                </geometry>
                <origin xyz="${origin}" rpy="0 0 0" />
            </collision>
            <inertial>
                <origin xyz="${origin}" rpy="0 0 0" />
                <mass value="${mass}" />
                <inertia
                    ixx="${mass * (3*radius*radius + length*length) / 12}"
                    ixy="0.0" ixz="0.0"
                    iyy="${mass * (3*radius*radius + length*length) / 12}"
                    iyz="0.0"
                    izz="${mass * radius * radius / 2}" />
            </inertial>
        </link>
    </xacro:macro>

</robot>