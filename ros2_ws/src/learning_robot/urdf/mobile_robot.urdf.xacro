<?xml version="1.0"?>

<robot name="mobile_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="common_macros.xacro" />

    <!-- ============ 属性 ============ -->
    <!-- 底盘 -->
    <xacro:property name="base_length" value="0.4" />
    <xacro:property name="base_width" value="0.3" />
    <xacro:property name="base_height" value="0.1" />
    <xacro:property name="base_mass" value="3.0" />

    <!-- 驱动轮 -->
    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="wheel_width" value="0.03" />
    <xacro:property name="wheel_mass" value="0.3" />
    <xacro:property name="wheel_y" value="0.17" />

    <!-- 万向轮 -->
    <xacro:property name="caster_radius" value="0.02" />
    <xacro:property name="caster_mass" value="0.1" />

    <!-- 材质 -->
    <xacro:declare_material name="grey" rgba="0.5 0.5 0.5 1.0" />
    <xacro:declare_material name="black" rgba="0.1 0.1 0.1 1.0" />
    <xacro:declare_material name="orange" rgba="0.9 0.5 0.1 1.0" />

    <!-- ============ 底盘 ============ -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <!-- 方向标记：橙色小方块在前方，方便区分朝向 -->
        <visual>
            <geometry>
                <box size="0.05 0.05 0.02" />
            </geometry>
            <origin xyz="0.18 0 0.05" rpy="0 0 0" />
            <material name="orange" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="${base_mass}" />
            <inertia
                ixx="${base_mass * (base_width*base_width + base_height*base_height) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${base_mass * (base_length*base_length + base_height*base_height) / 12}"
                iyz="0.0"
                izz="${base_mass * (base_length*base_length + base_width*base_width) / 12}" />
        </inertial>
    </link>

    <!-- ============ 左轮 ============ -->
    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="${wheel_mass}" />
            <!-- 圆柱旋转 90° 后，轴向沿 y，所以 Iyy 是轴向惯量 -->
            <inertia
                ixx="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${wheel_mass * wheel_radius * wheel_radius / 2}"
                iyz="0.0"
                izz="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}" />
        </inertial>
    </link>

    <joint name="base_to_left_wheel" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="0 ${wheel_y} ${-base_height/2}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- ============ 右轮 ============ -->
    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="${wheel_mass}" />
            <inertia
                ixx="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${wheel_mass * wheel_radius * wheel_radius / 2}"
                iyz="0.0"
                izz="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}" />
        </inertial>
    </link>

    <joint name="base_to_right_wheel" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="0 ${-wheel_y} ${-base_height/2}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- ============ 后万向轮 ============ -->
    <link name="caster_link">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="${caster_mass}" />
            <inertia
                ixx="${2*caster_mass*caster_radius*caster_radius/5}"
                ixy="0.0" ixz="0.0"
                iyy="${2*caster_mass*caster_radius*caster_radius/5}"
                iyz="0.0"
                izz="${2*caster_mass*caster_radius*caster_radius/5}" />
        </inertial>
    </link>

    <joint name="base_to_caster" type="fixed">
        <parent link="base_link" />
        <child link="caster_link" />
        <origin xyz="-0.15 0 ${-base_height/2 - 0.03}" rpy="0 0 0" />
    </joint>

    <!-- ============ 前万向轮 ============ -->
    <link name="front_caster_link">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="${caster_mass}" />
            <inertia
                ixx="${2*caster_mass*caster_radius*caster_radius/5}"
                ixy="0.0" ixz="0.0"
                iyy="${2*caster_mass*caster_radius*caster_radius/5}"
                iyz="0.0"
                izz="${2*caster_mass*caster_radius*caster_radius/5}" />
        </inertial>
    </link>

    <joint name="base_to_front_caster" type="fixed">
        <parent link="base_link" />
        <child link="front_caster_link" />
        <origin xyz="0.15 0 ${-base_height/2 - 0.03}" rpy="0 0 0" />
    </joint>

    <!-- 万向轮摩擦系数改为 0，让它能在平面上滑动 -->
    <gazebo reference="caster_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
    </gazebo>

    <gazebo reference="front_caster_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
    </gazebo>

    <!-- 轮子摩擦系数调高，保证抓地力 -->
    <gazebo reference="left_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="right_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <!-- ============ ros2_control 硬件接口声明 ============ -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="base_to_left_wheel">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>
        <joint name="base_to_right_wheel">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>
    </ros2_control>

    <!-- ============ gz_ros2_control Gazebo 插件 ============ -->
    <gazebo>
        <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find learning_robot)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- ============ 激光雷达 ============ -->
    <xacro:property name="lidar_radius" value="0.03" />
    <xacro:property name="lidar_height" value="0.04" />
    <xacro:property name="lidar_mass" value="0.1" />

    <xacro:cylinder_link
        name="lidar_link"
        radius="${lidar_radius}" length="${lidar_height}"
        mass="${lidar_mass}" color="black" />

    <joint name="base_to_lidar" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="0 0 ${base_height/2 + lidar_height/2}" rpy="0 0 0" />
    </joint>

    <!-- ============ Gazebo 激光雷达传感器插件 ============ -->
    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <update_rate>10</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>

</robot>